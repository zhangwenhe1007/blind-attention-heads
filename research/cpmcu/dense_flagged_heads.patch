+    void dense_heads_overwrite(const Stream& stream, int32_t num_tokens, int32_t seqlen_k, T* q, T* k_cache, T* v_cache,
+                               int* seqlens_k, const Mask& mask) {
+        const int G = this->num_attention_heads / this->num_key_value_heads;
+        for (int h = 0; h < this->num_key_value_heads; h++) {
