+    void force_dense_heads(const Stream& stream, uint64_t* blockmask, int num_tokens, int k_len) {
+        if (this->dense_kv_mask == 0 || blockmask == nullptr || this->dense_by_kernel) return;
+        const int k_blocks = (k_len + 64 - 1) / 64;
+        const int n_uint64_per_row = (k_blocks + 64 - 1) / 64;
+        for (int h = 0; h < this->num_key_value_heads; h++) {
+            if (this->dense_kv_mask & (1u << h)) {
+                cudaMemsetAsync(blockmask + (size_t)h * num_tokens * n_uint64_per_row, 0xFF,
+                                (size_t)num_tokens * n_uint64_per_row * sizeof(uint64_t), stream.stream);
+            }
+        }
+    }
 
