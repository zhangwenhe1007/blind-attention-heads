diff --git a/src/model/minicpm4/minicpm4_model.cuh b/src/model/minicpm4/minicpm4_model.cuh
index 0d751b5..240f35a 100644
--- a/src/model/minicpm4/minicpm4_model.cuh
+++ b/src/model/minicpm4/minicpm4_model.cuh
@@ -1,4 +1,7 @@
 #pragma once
+#include <cstdlib>
+#include <string>
+#include <cstdio>
 #include "../model.cuh"
 #include "minicpm4_layer.cuh"
 #include "minicpm4_kvcache.cuh"
@@ -66,6 +69,27 @@ struct MiniCPM4Impl : Model {
         for (int i = 0; i < num_hidden_layers; i++) {
             layers.push_back(new MiniCPM4Layer<T>(hidden_size, intermediate_size, num_attention_heads, num_key_value_heads, head_dim, rms_norm_eps, residual_scale, sink_window_size, block_window_size, sparse_switch, use_compress_lse));
         }
+        // flagged-heads patch: CPMCU_DENSE_KV_HEADS="9.0,16.0,22.0" gives those layer.kv_head pairs full attention
+        if (const char* env = std::getenv("CPMCU_DENSE_KV_HEADS")) {
+            std::string spec(env);
+            size_t pos = 0;
+            while (pos < spec.size()) {
+                size_t comma = spec.find(',', pos);
+                std::string item = spec.substr(pos, comma == std::string::npos ? std::string::npos : comma - pos);
+                size_t dot = item.find('.');
+                if (dot != std::string::npos) {
+                    int l = std::stoi(item.substr(0, dot)), h = std::stoi(item.substr(dot + 1));
+                    if (l < 0 || l >= num_hidden_layers || h < 0 || h >= num_key_value_heads)
+                        throw std::invalid_argument("CPMCU_DENSE_KV_HEADS entry out of range: " + item);
+                    layers[l]->attn->dense_kv_mask |= (1u << h);
+                    const char* mode = std::getenv("CPMCU_DENSE_KV_MODE");
+                    layers[l]->attn->dense_by_kernel = (mode != nullptr && std::string(mode) == "kernel");
+                    fprintf(stderr, "[flagged-heads patch] full attention in layer %d kv head %d (%s)\n", l, h, layers[l]->attn->dense_by_kernel ? "dense kernel" : "all-ones block mask");
+                }
+                if (comma == std::string::npos) break;
+                pos = comma + 1;
+            }
+        }
         norm = new RMSNorm<T>(hidden_size, rms_norm_eps);
         lm_head = new LMHead<T>(hidden_size, vocab_size, scale_lmhead);
     }
