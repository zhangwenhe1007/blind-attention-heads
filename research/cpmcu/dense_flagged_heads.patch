+            mha_fwd_kvcache(
+                TypeTraits<T>::type_code()==1, 1, num_tokens, seqlen_k, G, 1, this->head_dim,
+                q + h * G * this->head_dim, k_cache + h * this->head_dim, v_cache + h * this->head_dim,
+                seqlens_k, mask, this->attn_output + h * G * this->head_dim,
+                this->softmax_lse, this->softmax_lse_accum, this->oaccum,
+                rsqrtf(float(this->head_dim)), true, -1, -1, 0, stream.stream, nullptr, 0,
+                this->num_attention_heads * this->head_dim, this->num_key_value_heads * this->head_dim);
+        }
+    }
